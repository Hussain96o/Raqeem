{
  "number": 77,
  "name": {
    "ar": "المرسلات",
    "transliteration": "Al-Mursalat"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 50,
  "words_count": 181,
  "letters_count": 815,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "وَٱلنَّـٰشِرَٰتِ نَشۡرٗا"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "عُذۡرًا أَوۡ نُذۡرًا"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "لِيَوۡمِ ٱلۡفَصۡلِ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 18,
      "text": {
        "ar": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 19,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 580,
      "sajda": false
    },
    {
      "number": 20,
      "text": {
        "ar": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 21,
      "text": {
        "ar": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 22,
      "text": {
        "ar": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 23,
      "text": {
        "ar": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 24,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 25,
      "text": {
        "ar": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 26,
      "text": {
        "ar": "أَحۡيَآءٗ وَأَمۡوَٰتٗا"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 27,
      "text": {
        "ar": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 28,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 29,
      "text": {
        "ar": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 30,
      "text": {
        "ar": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 31,
      "text": {
        "ar": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 32,
      "text": {
        "ar": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 33,
      "text": {
        "ar": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 34,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 35,
      "text": {
        "ar": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 36,
      "text": {
        "ar": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 37,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 38,
      "text": {
        "ar": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 39,
      "text": {
        "ar": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 40,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 41,
      "text": {
        "ar": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 42,
      "text": {
        "ar": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 43,
      "text": {
        "ar": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 44,
      "text": {
        "ar": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 45,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 46,
      "text": {
        "ar": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 47,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 48,
      "text": {
        "ar": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 49,
      "text": {
        "ar": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    },
    {
      "number": 50,
      "text": {
        "ar": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ"
      },
      "juz": 29,
      "page": 581,
      "sajda": false
    }
  ]
}
