  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "فَٱلۡمُورِيَٰتِ قَدۡحٗا"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "فَٱلۡمُغِيرَٰتِ صُبۡحٗا"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "فَأَثَرۡنَ بِهِۦ نَقۡعٗا"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "فَوَسَطۡنَ بِهِۦ جَمۡعًا"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ"
      },
      "juz": 30,
      "page": 599,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    }
  ]
}
