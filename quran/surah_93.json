  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلضُّحَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَٱلَّيۡلِ إِذَا سَجَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    }
  ]
}
