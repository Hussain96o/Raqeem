{
  "number": 88,
  "name": {
    "ar": "الغاشية",
    "transliteration": "Al-Ghashiyah"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 26,
  "words_count": 92,
  "letters_count": 378,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "عَامِلَةٞ نَّاصِبَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "تَصۡلَىٰ نَارًا حَامِيَةٗ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "لِّسَعۡيِهَا رَاضِيَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "فِي جَنَّةٍ عَالِيَةٖ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "فِيهَا عَيۡنٞ جَارِيَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "وَنَمَارِقُ مَصۡفُوفَةٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "وَزَرَابِيُّ مَبۡثُوثَةٌ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 18,
      "text": {
        "ar": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 19,
      "text": {
        "ar": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 20,
      "text": {
        "ar": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 21,
      "text": {
        "ar": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 22,
      "text": {
        "ar": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 23,
      "text": {
        "ar": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 24,
      "text": {
        "ar": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 25,
      "text": {
        "ar": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    },
    {
      "number": 26,
      "text": {
        "ar": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم"
      },
      "juz": 30,
      "page": 592,
      "sajda": false
    }
  ]
}
