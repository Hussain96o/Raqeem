  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "ٱلۡقَارِعَةُ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "مَا ٱلۡقَارِعَةُ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "فَأُمُّهُۥ هَاوِيَةٞ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "نَارٌ حَامِيَةُۢ"
      },
      "juz": 30,
      "page": 600,
      "sajda": false
    }
  ]
