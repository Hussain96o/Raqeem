{
  "number": 90,
  "name": {
    "ar": "البلد",
    "transliteration": "Al-Balad"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 20,
  "words_count": 82,
  "letters_count": 335,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "وَوَالِدٖ وَمَا وَلَدَ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "وَلِسَانٗا وَشَفَتَيۡنِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "فَكُّ رَقَبَةٍ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "يَتِيمٗا ذَا مَقۡرَبَةٍ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 18,
      "text": {
        "ar": "أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 19,
      "text": {
        "ar": "وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    },
    {
      "number": 20,
      "text": {
        "ar": "عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ"
      },
      "juz": 30,
      "page": 594,
      "sajda": false
    }
  ]
}
