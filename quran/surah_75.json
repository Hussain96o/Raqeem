{
  "number": 75,
  "name": {
    "ar": "القيامة",
    "transliteration": "Al-Qiyamah"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 40,
  "words_count": 164,
  "letters_count": 664,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "فَإِذَا بَرِقَ ٱلۡبَصَرُ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "وَخَسَفَ ٱلۡقَمَرُ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "كَلَّا لَا وَزَرَ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 18,
      "text": {
        "ar": "فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 19,
      "text": {
        "ar": "ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ"
      },
      "juz": 29,
      "page": 577,
      "sajda": false
    },
    {
      "number": 20,
      "text": {
        "ar": "كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 21,
      "text": {
        "ar": "وَتَذَرُونَ ٱلۡأٓخِرَةَ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 22,
      "text": {
        "ar": "وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 23,
      "text": {
        "ar": "إِلَىٰ رَبِّهَا نَاظِرَةٞ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 24,
      "text": {
        "ar": "وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 25,
      "text": {
        "ar": "تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 26,
      "text": {
        "ar": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 27,
      "text": {
        "ar": "وَقِيلَ مَنۡۜ رَاقٖ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 28,
      "text": {
        "ar": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 29,
      "text": {
        "ar": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 30,
      "text": {
        "ar": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 31,
      "text": {
        "ar": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 32,
      "text": {
        "ar": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 33,
      "text": {
        "ar": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 34,
      "text": {
        "ar": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 35,
      "text": {
        "ar": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 36,
      "text": {
        "ar": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 37,
      "text": {
        "ar": "أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 38,
      "text": {
        "ar": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 39,
      "text": {
        "ar": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    },
    {
      "number": 40,
      "text": {
        "ar": "أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ"
      },
      "juz": 29,
      "page": 578,
      "sajda": false
    }
  ]
}
