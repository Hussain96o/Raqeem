{
  "number": 86,
  "name": {
    "ar": "الطارق",
    "transliteration": "At-Tariq"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 17,
  "words_count": 61,
  "letters_count": 249,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلسَّمَآءِ وَٱلطَّارِقِ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "ٱلنَّجۡمُ ٱلثَّاقِبُ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "خُلِقَ مِن مَّآءٖ دَافِقٖ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "وَمَا هُوَ بِٱلۡهَزۡلِ"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "وَأَكِيدُ كَيۡدٗا"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا"
      },
      "juz": 30,
      "page": 591,
      "sajda": false
    }
  ]
}
