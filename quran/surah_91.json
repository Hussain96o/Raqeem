{
  "number": 91,
  "name": {
    "ar": "الشمس",
    "transliteration": "Ash-Shams"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 15,
  "words_count": 54,
  "letters_count": 249,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلشَّمۡسِ وَضُحَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَٱلۡقَمَرِ إِذَا تَلَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "وَنَفۡسٖ وَمَا سَوَّىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "وَقَدۡ خَابَ مَن دَسَّىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "وَلَا يَخَافُ عُقۡبَٰهَا"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    }
  ]
}
