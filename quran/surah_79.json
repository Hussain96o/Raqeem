{
  "number": 79,
  "name": {
    "ar": "النازعات",
    "transliteration": "An-Nazi'at"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 46,
  "words_count": 179,
  "letters_count": 762,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلنَّـٰزِعَٰتِ غَرۡقٗا"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَٱلنَّـٰشِطَٰتِ نَشۡطٗا"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "وَٱلسَّـٰبِحَٰتِ سَبۡحٗا"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "فَٱلسَّـٰبِقَٰتِ سَبۡقٗا"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "تَتۡبَعُهَا ٱلرَّادِفَةُ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "أَبۡصَٰرُهَا خَٰشِعَةٞ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "فَإِذَا هُم بِٱلسَّاهِرَةِ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"
      },
      "juz": 30,
      "page": 583,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 18,
      "text": {
        "ar": "فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 19,
      "text": {
        "ar": "وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 20,
      "text": {
        "ar": "فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 21,
      "text": {
        "ar": "فَكَذَّبَ وَعَصَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 22,
      "text": {
        "ar": "ثُمَّ أَدۡبَرَ يَسۡعَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 23,
      "text": {
        "ar": "فَحَشَرَ فَنَادَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 24,
      "text": {
        "ar": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 25,
      "text": {
        "ar": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 26,
      "text": {
        "ar": "إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 27,
      "text": {
        "ar": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 28,
      "text": {
        "ar": "رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 29,
      "text": {
        "ar": "وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 30,
      "text": {
        "ar": "وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 31,
      "text": {
        "ar": "أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 32,
      "text": {
        "ar": "وَٱلۡجِبَالَ أَرۡسَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 33,
      "text": {
        "ar": "مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 34,
      "text": {
        "ar": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 35,
      "text": {
        "ar": "يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 36,
      "text": {
        "ar": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 37,
      "text": {
        "ar": "فَأَمَّا مَن طَغَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 38,
      "text": {
        "ar": "وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 39,
      "text": {
        "ar": "فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 40,
      "text": {
        "ar": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 41,
      "text": {
        "ar": "فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 42,
      "text": {
        "ar": "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 43,
      "text": {
        "ar": "فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 44,
      "text": {
        "ar": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 45,
      "text": {
        "ar": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    },
    {
      "number": 46,
      "text": {
        "ar": "كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا"
      },
      "juz": 30,
      "page": 584,
      "sajda": false
    }
  ]
}
