{
  "number": 92,
  "name": {
    "ar": "الليل",
    "transliteration": "Al-Layl"
  },
  "revelation_place": {
    "ar": "مكية"
  },
  "verses_count": 21,
  "words_count": 71,
  "letters_count": 312,
  "verses": [
    {
      "number": 1,
      "text": {
        "ar": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 2,
      "text": {
        "ar": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 3,
      "text": {
        "ar": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 4,
      "text": {
        "ar": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 5,
      "text": {
        "ar": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 6,
      "text": {
        "ar": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 7,
      "text": {
        "ar": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 8,
      "text": {
        "ar": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 9,
      "text": {
        "ar": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 10,
      "text": {
        "ar": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 11,
      "text": {
        "ar": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 12,
      "text": {
        "ar": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 13,
      "text": {
        "ar": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 14,
      "text": {
        "ar": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ"
      },
      "juz": 30,
      "page": 595,
      "sajda": false
    },
    {
      "number": 15,
      "text": {
        "ar": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 16,
      "text": {
        "ar": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 17,
      "text": {
        "ar": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 18,
      "text": {
        "ar": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 19,
      "text": {
        "ar": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 20,
      "text": {
        "ar": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    },
    {
      "number": 21,
      "text": {
        "ar": "وَلَسَوۡفَ يَرۡضَىٰ"
      },
      "juz": 30,
      "page": 596,
      "sajda": false
    }
  ]
}
